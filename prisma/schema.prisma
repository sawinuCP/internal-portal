// Prisma schema for the internal portal.
// - User      : portal members. Passwords are stored as bcrypt hashes only.
// - Session   : server-side sessions. The DB stores only the SHA-256 hash of the
//               cookie token, so a leaked database cannot be used to forge cookies.
// - Announcement : the portal's single content section (create + view feed).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String
  passwordHash  String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sessions      Session[]
  announcements Announcement[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  userAgent String? // captured at login; foundation for "active devices" awareness
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}
